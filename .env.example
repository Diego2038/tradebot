# Copia este archivo a .env y ajusta los valores. NO subas .env al repo.

# --- Base de datos ---
POSTGRES_USER=tradebot
POSTGRES_PASSWORD=tradebot
POSTGRES_DB=tradebot

# --- Clave maestra de cifrado (OBLIGATORIA) ---
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --- Alpaca ---
# Barrera de seguridad. Debe permanecer true en esta fase (solo dinero ficticio).
ALPACA_PAPER_ONLY=true
DEFAULT_SYMBOL=BTC/USD

# NOTA: la API Key/Secret de Alpaca NO se ponen aquí. Se ingresan desde el frontend
# y el backend las guarda cifradas en la base de datos.

# --- Frontend ---
API_BASE_URL=http://localhost:8000
WS_BASE_URL=ws://localhost:8000/ws/bot

DEBUG=false
